{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "templates/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/chat", "dest": "/api/index.py" },
    { "src": "/appointments", "dest": "/api/index.py" },
    { "src": "/appointments/.*", "dest": "/api/index.py" },
    { "src": "/admin", "dest": "/api/index.py" },
    { "src": "/", "dest": "/api/index.py" }
  ]
}

